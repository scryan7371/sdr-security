{
  "name": "@scryan7371/sdr-security",
  "version": "0.1.18",
  "description": "Reusable auth/security capability for API and app clients.",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "require": "./dist/nest/index.js",
      "default": "./dist/nest/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "require": "./dist/drizzle/index.js",
      "default": "./dist/drizzle/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"README.md\"",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "coverage": "vitest run --coverage",
    "test:db:keep": "SECURITY_TEST_KEEP_SCHEMA=true SECURITY_TEST_SCHEMA=sdr_security_it_debug npm run test:db",
    "test:db:teardown": "SECURITY_TEST_SCHEMA=sdr_security_it_debug npm run test:db",
    "release:patch": "bash ./scripts/release.sh patch",
    "release:minor": "bash ./scripts/release.sh minor",
    "release:major": "bash ./scripts/release.sh major",
    "ci:prepush": "npm run lint && npm run test",
    "prepush": "npm run ci:prepush"
  },
  "dependencies": {
    "@babel/runtime": "8.0.5",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "^0.45.3",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "@nestjs/typeorm": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/testing": "^12.1.0",
    "@nestjs/typeorm": "12.0.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supertest": "^7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "typesVersions": {
    "*": {
      "nest": [
        "dist/nest/index.d.ts"
      ],
      "drizzle": [
        "dist/drizzle/index.d.ts"
      ]
    }
  }
}
